---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FormationCard from '../../components/FormationCard.astro';
import Enseignements from '../../components/Enseignements.astro';
import { completePedagogy } from '../../lib/pedagogie';
import { sources } from '../../data/pedagogie-formations';
import { familleOf, getContent, pageBySlug, pathOf, type Formation } from '../../lib/wordpress';
import { institut } from '../../lib/institut';
import { featured, image, plain, publicLinks } from '../../lib/html';
import { listItems, tableRows } from '../../lib/extract';
export async function getStaticPaths() {
  const { formations } = await getContent();
  return formations.map((formation, index) => ({ params: { slug: formation.slug }, props: { formation, index } }));
}
const { formation: original, index } = Astro.props as { formation: Formation; index: number };
const { formation, pedagogie, supplemented } = completePedagogy(original);
const hasTeachingSupplement = supplemented.includes('enseignements');
const { formations, pages, media } = await getContent();
const { meta } = formation;
const img = featured(formation, '') ?? image(media[({ 'gestion-finance': 'banque.avif', 'management-marketing': 'rh.avif', 'droit-relations-internationales': 'fiscalite_1.avif', 'commerce-logistique': 'logistique.webp', 'communication-numerique': 'F89A7166-scaled-1.avif', 'developpement-secteurs-specialises': 'F89A7161-scaled-1.avif' } as Record<string, string>)[familleOf(formation)?.slug ?? ''] ?? 'etudiants.avif'], '');
const famille = familleOf(formation);
const admission = pageBySlug(pages, 'admission');
const contacts = pageBySlug(pages, 'contacts');
const applyHref = admission ? pathOf(admission) : contacts ? pathOf(contacts) : '/';

// Parcours : tableau Niveau / Durée / Objectif, sinon niveau et durée simples
const parcours = tableRows(meta.parcours).map(row => row.map(plain));
const durations = parcours.length ? parcours.map(([level, duration]) => ({ level, duration })) : [{ level: meta.niveau, duration: meta.duree }].filter(d => d.level || d.duration);
const competences = tableRows(meta.competences).map(row => ({ title: plain(row[0]), text: plain(row[1] ?? '') }));
const competenceItems = competences.length ? competences : listItems(meta.competences).filter(item => item.title);
const methodes = listItems(meta.methodes).map(item => item.title ? `${item.title} ${item.text}` : item.text);
const debouches = tableRows(meta.debouches).map(row => ({ sector: plain(row[0]), jobs: plain(row[1] ?? '') }));
const carriere = listItems(meta.carriere).map(item => item.title ? `${item.title} ${item.text}` : item.text);

const sections = [
  { id: 'objectifs', label: 'Objectifs', show: !!plain(formation.content.rendered) },
  { id: 'parcours', label: 'Parcours', show: parcours.length > 0 },
  { id: 'finalite', label: 'Finalité', show: !!plain(meta.finalite) },
  { id: 'admission', label: 'Admission', show: !!plain(meta.admission) },
  { id: 'enseignements', label: 'Enseignements', show: hasTeachingSupplement || !!plain(meta.enseignements) },
  { id: 'competences', label: 'Compétences', show: !!plain(meta.competences) },
  { id: 'methodes', label: 'Méthodes', show: !!plain(meta.methodes) },
  { id: 'debouches', label: 'Débouchés', show: !!plain(meta.debouches) },
  { id: 'carriere', label: 'Et après', show: !!plain(meta.carriere) },
].filter(s => s.show);
const others = formations.filter(other => other.id !== formation.id);
---
<Base title={formation.title.rendered} description={plain(formation.content.rendered).slice(0, 160)} image={img?.src} cta={{ label: 'Candidater à cette formation', href: applyHref }}>
  <PageHero title={formation.title.rendered} kicker={`Formation ${meta.reference || String(index + 1).padStart(2, '0')}${famille ? ` · ${famille.name}` : ''}`} img={img}>
    {durations.length > 0 && <div class="durations">{durations.map(d => <div><small>{d.level}</small><strong>{d.duration}</strong></div>)}</div>}
  </PageHero>

  {sections.length > 1 && <nav class="toc" aria-label="Sommaire de la formation"><div class="wrap">{sections.map(s => <a href={`#${s.id}`}>{s.label}</a>)}</div></nav>}

  <div class="wrap formation-layout">
    <article class="formation">
      {pedagogie && supplemented.length > 0 && <div class="pedagogy-note">
        <strong>À propos des compléments pédagogiques</strong>
        <p>Les compléments ci-dessous sont proposés à titre indicatif à partir des programmes AFI-UE. Le programme définitif et les niveaux ouverts sont à confirmer auprès du service admission.</p>
        {pedagogie.adaptation && <p>{pedagogie.adaptation}</p>}
        <details>
          <summary>Références et rubriques complétées</summary>
          <p>Rubriques : {supplemented.map(key => sections.find(section => section.id === key)?.label ?? key).join(', ')}. Synthèse adaptée des programmes suivants :</p>
          <ul>{pedagogie.sources.map(key => <li><a href={`https://afi-ue.sn/${sources[key][1]}/`}>{sources[key][0]} — AFI-UE</a></li>)}</ul>
        </details>
      </div>}
      {sections.length === 0 && <section id="catalogue">
        <h2>{formation.title.rendered}{meta.sigle && ` (${meta.sigle})`}</h2>
        <p>Cette formation fait partie du catalogue de l’Université VITO S.{famille && <> Elle relève du domaine « {famille.name} ».</>}</p>
        <p class="note">Le diplôme concerné ({institut.levels.join(', ')}), la durée, les conditions d’accès et les débouchés sont en cours de validation par l’établissement. Contactez le service admission pour connaître les niveaux ouverts et le dossier à fournir.</p>
      </section>}
      {sections.some(s => s.id === 'objectifs') && <section id="objectifs"><h2>Objectifs</h2><div class="prose" set:html={publicLinks(formation.content.rendered)} /></section>}
      {parcours.length > 0 && <section id="parcours">
        <h2>Un parcours en {parcours.length} marche{parcours.length > 1 ? 's' : ''}</h2>
        <div class="parcours">{parcours.map(([level, duration, goal]) => <div><small>{level} · {duration}</small>{goal}</div>)}</div>
      </section>}
      {plain(meta.finalite) && <section id="finalite"><h2>Finalité de la formation</h2><div class="prose" set:html={publicLinks(meta.finalite)} /></section>}
      {plain(meta.admission) && <section id="admission"><h2>Conditions d’admission</h2><div class="prose" set:html={publicLinks(meta.admission)} /></section>}
      {(hasTeachingSupplement || plain(meta.enseignements)) && <section id="enseignements">
        <h2>Enseignements principaux</h2>
        {hasTeachingSupplement && pedagogie ? <Enseignements pedagogie={pedagogie} /> : <div class="prose" set:html={publicLinks(meta.enseignements)} />}
      </section>}
      {plain(meta.competences) && <section id="competences">
        <h2>Compétences visées</h2>
        {competenceItems.length ? <div class="accordion">{competenceItems.map((item, i) => <details open={i === 0}><summary>{item.title}</summary><p>{item.text}</p></details>)}</div>
          : <div class="prose" set:html={publicLinks(meta.competences)} />}
      </section>}
      {plain(meta.methodes) && <section id="methodes">
        <h2>Comment on apprend</h2>
        {methodes.length ? <ul class="tiles">{methodes.map(item => <li>{item}</li>)}</ul> : <div class="prose" set:html={publicLinks(meta.methodes)} />}
      </section>}
      {plain(meta.debouches) && <section id="debouches">
        <h2>Débouchés</h2>
        {debouches.length ? <div class="outlets">{debouches.map(d => <div><small>{d.sector}</small>{d.jobs}</div>)}</div>
          : <div class="prose" set:html={publicLinks(meta.debouches)} />}
      </section>}
      {plain(meta.carriere) && <section id="carriere">
        <h2>Et après ?</h2>
        {carriere.length ? <ul class="chips">{carriere.map(item => <li>{item}</li>)}</ul> : <div class="prose" set:html={publicLinks(meta.carriere)} />}
      </section>}
    </article>
    <aside class="formation-aside">
      <strong>Intéressé par cette formation ?</strong>
      <p>Consultez la procédure d’admission ou contactez notre équipe.</p>
      <a class="btn btn--mango" href={applyHref}>Candidater</a>
      {contacts && <a class="btn btn--outline" href={pathOf(contacts)}>Nous contacter</a>}
    </aside>
  </div>

  {others.length > 0 && <section class="section section--white">
    <div class="wrap">
      <div class="section__head"><h2>Autres formations</h2></div>
      <div class="cards">{others.map(other => <FormationCard formation={other} index={formations.indexOf(other)} />)}</div>
    </div>
  </section>}
</Base>

<style>
  .pedagogy-note { margin-bottom: 2rem; padding: 1.25rem 1.5rem; border-left: 3px solid #ffca3a; background: #f5f6fa; border-radius: 0 .75rem .75rem 0; font-size: .95rem; }
  .pedagogy-note p { margin: .65rem 0; }
  .pedagogy-note summary { cursor: pointer; font-weight: 600; text-decoration: underline; text-underline-offset: .2em; }
  .pedagogy-note ul { padding-left: 1.2rem; }
  .pedagogy-note a { overflow-wrap: anywhere; }
</style>
