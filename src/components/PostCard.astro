---
import Picture from './Picture.astro';
import type { Entry } from '../lib/wordpress';
import { featured } from '../lib/html';
const { post } = Astro.props as { post: Entry };
---
<a class="card" href={`/actualites/${post.slug}/`}>
  <div class="card__media"><Picture img={featured(post)} sizes="(min-width: 900px) 33vw, 290px" /></div>
  <div class="card__body">
    <h3 set:html={post.title.rendered} />
  </div>
</a>
