ErrorDocument 404 /404.html

# Anciennes adresses du site Elementor
RedirectMatch 301 ^/(catalogue-de-formations|filieres)/?$ /formations/

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|svg|webp|avif|png|jpe?g)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Fichiers générés par Astro : nom contenant une empreinte, donc immuables
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
