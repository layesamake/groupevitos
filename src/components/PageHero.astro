---
// Bandeau des pages intérieures : fond cobalt, titre, photo rognée en gradins.
import Picture from './Picture.astro';
import type { Img } from '../lib/html';
interface Props { title: string; lead?: string; kicker?: string; img?: Img; cutout?: boolean }
// cutout : photo détourée (fond transparent), posée en bas du bandeau sans rognage
const { title, lead, kicker, img, cutout = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--image': img }]}>
  <div class="wrap page-hero__inner">
    <div class="page-hero__text">
      {kicker && <p class="page-hero__kicker" set:html={kicker} />}
      <h1 set:html={title} />
      {lead && <p class="page-hero__lead" set:html={lead} />}
      <slot />
    </div>
    {img && <Picture class:list={['page-hero__image', cutout ? 'page-hero__image--cutout' : 'stepped']} img={img} sizes="(min-width: 900px) 45vw, 100vw" eager />}
  </div>
</section>
