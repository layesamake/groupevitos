---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FormationCard from '../components/FormationCard.astro';
import FamilyFilter from '../components/FamilyFilter.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import PlaquetteForm from '../components/PlaquetteForm.astro';
import { familiesOf, getContent, pageBySlug, pathOf } from '../lib/wordpress';
import { featured, image, plain } from '../lib/html';
import { figures, listItems, section, stairLines, steps } from '../lib/extract';
import { institut } from '../lib/institut';
import { POLES, ofType, telHref } from '../lib/referentiel';

const { available, site, pages, formations, partenaires, coordonnees, identite, media } = await getContent();
const page = (slug: string) => pageBySlug(pages, slug);
const byFile = (url: string) => media[url.split('/').pop()!];

const slogan = plain(site.description) || identite.devise.replace(/[.!]$/, '');
const lines = stairLines(slogan.replace(/[.!]$/, ''));
const students = image(media['etudiants-groupe.webp'] ?? media['etudiants.avif'], 'Étudiantes et étudiants de l’Institut VITO S. en uniforme');
const cutout = !!media['etudiants-groupe.webp'];

const home = page('accueil')?.content.rendered ?? '';
const why = listItems(section(home, /pourquoi/i));

const admission = page('admission');
const admissionSteps = steps(admission?.content.rendered ?? '').slice(0, 3);

const galerie = page('galeries');
const photos = figures(galerie?.content.rendered ?? '');
const mosaic = [photos.find(p => /dipl/i.test(p.caption)), photos.find(p => /cultur/i.test(p.caption)), photos.filter(p => /dipl/i.test(p.caption))[3], photos.filter(p => /cultur/i.test(p.caption))[1]].filter(Boolean) as typeof photos;

const contactsPage = page('contacts');
const address = contactsPage?.content.rendered.match(/<p[^>]*>[^<]*<a[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/);
const phone = ofType(coordonnees, 'telephone')[0];
const email = ofType(coordonnees, 'email')[0];
const poles = POLES.filter(pole => page(pole.slug));
const reperes = [
  { value: '2009', label: 'Création, agrément de l’État' },
  { value: String(POLES.length), label: 'Pôles : Université, Lycée, ITP' },
  ...(formations.length ? [{ value: String(formations.length), label: 'Formations au catalogue universitaire' }] : []),
  { value: '3', label: 'Diplômes universitaires : DUT, Licence, Master' },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="hero__badge"><span aria-hidden="true"></span>{institut.badge}</p>
        <h1 aria-label={slogan}>{lines.map((line, i) => <span aria-hidden="true">{line}{i === lines.length - 1 ? '.' : ''}</span>)}</h1>
        <p class="hero__lead">{available ? institut.lead : 'Notre nouveau site arrive très bientôt.'}</p>
        <div class="hero__actions">
          {poles.length > 0 && <a class="btn btn--mango" href="#poles">Choisir mon pôle <span aria-hidden="true">→</span></a>}
          {admission && <a class="btn btn--ghost" href={pathOf(admission)}>Admissions et frais</a>}
        </div>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <span class="hero__step">I</span><span class="hero__step">V</span><span class="hero__step">S</span>
        <div class:list={['hero__photo', { 'hero__photo--cutout': cutout }]}><Picture img={students} sizes="300px" eager alt="" /></div>
      </div>
      <div class="hero__gallery">
        <Picture img={image(media['graduation-1.jpg'], 'Remise de diplômes')} sizes="20vw" />
        <Picture img={image(media['F89A7166-scaled-1.avif'], 'Étudiants en cours')} sizes="20vw" />
        <div class:list={{ 'hero__cutout': cutout }}><Picture img={students} sizes="28vw" /></div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true"><div class="ticker__track">{[...institut.ticker, ...institut.ticker, ...institut.ticker, ...institut.ticker].map(item => <span>{item}</span>)}</div></div>

  {poles.length > 0 && <section class="section" id="poles">
    <div class="wrap">
      <div class="section__head"><Eyebrow number="01">Nos pôles</Eyebrow><h2>Trois pôles, un seul groupe</h2></div>
      <div class="poles">{poles.map(pole => <a class="pole" href={pole.path}><h3>{pole.name}</h3><p>{pole.lead}</p><span class="pole__more">Découvrir →</span></a>)}</div>
    </div>
  </section>}

  {formations.length > 0 && <section class="section section--white" id="formations">
    <div class="wrap">
      <div class="section__head section__head--row">
        <div class="section__head"><Eyebrow number="02">Université</Eyebrow><h2>Trouvez votre voie</h2></div>
        <FamilyFilter target="#cartes-accueil" families={familiesOf(formations)} />
      </div>
      <div class="carousel" data-carousel>
        <div class="carousel__bar">
          <p class="carousel__count" aria-live="polite"></p>
          <div class="carousel__nav">
            <button type="button" class="carousel__btn" data-dir="-1" aria-label="Formations précédentes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button type="button" class="carousel__btn" data-dir="1" aria-label="Formations suivantes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        </div>
        <div class="carousel__viewport">
        <div class="cards cards--row" id="cartes-accueil" tabindex="0" role="region" aria-label="Liste des formations : utilisez les flèches ou les touches gauche et droite">{formations.map((formation, index) => <FormationCard formation={formation} index={index} />)}</div>
        </div>
      </div>
      <a class="btn btn--outline btn--wide more-link" href="/formations/">Voir les {formations.length} formations <span aria-hidden="true">→</span></a>
    </div>
  </section>}


  <script>
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(root => {
      const list = root.querySelector<HTMLElement>('.cards')!;
      const viewport = root.querySelector<HTMLElement>('.carousel__viewport')!;
      const count = root.querySelector<HTMLElement>('.carousel__count')!;
      const [prev, next] = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel__btn'));
      const cards = () => Array.from(list.children).filter(card => !(card as HTMLElement).hidden) as HTMLElement[];
      const update = () => {
        const all = cards(), box = list.getBoundingClientRect();
        const seen = all.map((card, index) => ({ index, rect: card.getBoundingClientRect() })).filter(({ rect }) => Math.min(rect.right, box.right) - Math.max(rect.left, box.left) >= rect.width * 0.5);
        const first = seen.length ? seen[0].index + 1 : 1, last = seen.length ? seen[seen.length - 1].index + 1 : Math.min(all.length, 1);
        count.textContent = all.length ? `${first}–${last} sur ${all.length} formations` : '';
        const atStart = list.scrollLeft <= 2, atEnd = list.scrollLeft + list.clientWidth >= list.scrollWidth - 2;
        prev.disabled = atStart; next.disabled = atEnd;
        viewport.dataset.end = String(atEnd);
        root.hidden = false;
      };
      let target: number | null = null, timer: ReturnType<typeof setTimeout>;
      const move = (dir: number) => {
        const shown = cards(), pas = shown.length > 1 ? shown[1].offsetLeft - shown[0].offsetLeft : 300;
        const step = pas * Math.max(1, Math.floor(list.clientWidth / pas));
        target = Math.max(0, Math.min((target ?? list.scrollLeft) + dir * step, list.scrollWidth - list.clientWidth));
        list.scrollTo({ left: target, behavior: 'smooth' });
        clearTimeout(timer); timer = setTimeout(() => { target = null; }, 700);
      };
      prev.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      list.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
      list.addEventListener('keydown', event => { if (event.key === 'ArrowRight') { event.preventDefault(); move(1); } if (event.key === 'ArrowLeft') { event.preventDefault(); move(-1); } });
      window.addEventListener('resize', update);
      document.querySelectorAll('[data-family-filter] button').forEach(button => button.addEventListener('click', () => { list.scrollTo({ left: 0 }); setTimeout(update, 0); }));
      // Glisser à la souris
      let startX = 0, startLeft = 0, dragging = false, moved = false;
      list.addEventListener('pointerdown', event => { if (event.pointerType !== 'mouse' || event.button !== 0) return; dragging = true; moved = false; startX = event.clientX; startLeft = list.scrollLeft; });
      window.addEventListener('pointermove', event => {
        if (!dragging) return;
        const delta = event.clientX - startX;
        if (Math.abs(delta) > 5) { moved = true; list.classList.add('is-dragging'); }
        if (moved) list.scrollLeft = startLeft - delta;
      });
      window.addEventListener('pointerup', () => { dragging = false; list.classList.remove('is-dragging'); });
      list.addEventListener('click', event => { if (moved) { event.preventDefault(); event.stopPropagation(); moved = false; } }, true);
      list.addEventListener('dragstart', event => event.preventDefault());
      update();
    });
  </script>

  {why.length > 0 && <section class="section">
    <div class="wrap why">
      <Picture class="why__image stepped" img={image(media['F89A7161-scaled-1.avif'], 'Étudiants en cours à l’Institut VITO S.')} sizes="(min-width: 900px) 50vw, 100vw" />
      <div>
        <div class="section__head"><Eyebrow number="03">Pourquoi nous</Eyebrow><h2>Chaque marche vous rapproche du métier</h2></div>
        <ol class="steps-list">
          {why.slice(0, 4).map((item, index) => <li><span class="steps-list__num">{index + 1}</span><div><h3>{item.title || item.text}</h3>{item.title && <p>{item.text}</p>}</div></li>)}
        </ol>
      </div>
    </div>
  </section>}

  <section class="section section--night" aria-label="Repères">
    <div class="wrap figures">{reperes.map(item => <div><strong>{item.value}</strong><span>{item.label}</span></div>)}</div>
  </section>

  {admission && <section class="section" id="admission">
    <div class="wrap admission">
      <div>
        <div class="section__head"><Eyebrow number="04">Admissions</Eyebrow><h2>Candidater en {admissionSteps.length || 3} marches</h2></div>
        {admissionSteps.length === 3 && <ol class="stairs">{admissionSteps.map(step => <li><b>{step.number}</b><span>{step.title}</span></li>)}</ol>}
      </div>
      <div class="admission__side">
        <p class="note">Chaque pôle a son dossier, ses tarifs et son contact : choisissez le vôtre.</p>
        <a class="btn btn--night btn--wide" href={pathOf(admission)}>Pièces à fournir et frais par pôle <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}

  {(mosaic.length > 0 || partenaires.length > 0) && <section class="section section--white">
    <div class="wrap">
      {mosaic.length > 0 && <>
        <div class="section__head"><Eyebrow number="05">Vie étudiante</Eyebrow><h2>La vie à VITO S.</h2></div>
        <div class="mosaic">
          {mosaic.map(photo => <Picture img={image(byFile(photo.src), photo.caption)} sizes="(min-width: 900px) 25vw, 50vw" />)}
          {galerie && <a class="mosaic__more" href={pathOf(galerie)}>Voir les {photos.length} photos <span aria-hidden="true">→</span></a>}
        </div>
      </>}
      {partenaires.length > 0 && <div class="partners">
        <p class="partners__label">Nos partenaires</p>
        {partenaires.map(partner => { const logo = featured(partner, partner.title.rendered); return <figure>{logo ? <Picture img={logo} sizes="104px" /> : <figcaption set:html={partner.meta.sigle || partner.title.rendered} />}</figure>; })}
      </div>}
    </div>
  </section>}

  <section class="section" id="plaquette">
    <div class="wrap">
      <div class="section__head"><Eyebrow>Documentation</Eyebrow><h2>Recevez la plaquette du Groupe</h2></div>
      <p>Formations, admissions, frais : tout le Groupe VITO S. dans un document. Recevez-le par e-mail ou sur WhatsApp.</p>
      <PlaquetteForm />
    </div>
  </section>

  {(phone || email) && <section class="section section--cobalt">
    <div class="wrap contact">
      <h2>Une question&nbsp;? Parlons-en.</h2>
      <div class="contact__list">
        {phone && <a class="contact__item" href={telHref(phone.meta.valeur)}><Icon name="phone" /><span><strong>Appeler {phone.meta.usage}</strong><span>{phone.meta.valeur}</span></span></a>}
        {email && <a class="contact__item" href={`mailto:${email.meta.valeur}`}><Icon name="mail" /><span><strong>Écrire un e-mail</strong><span>{email.meta.valeur}</span></span></a>}
        {address && <a class="contact__item" href={address[1]}><Icon name="pin" /><span><strong>Itinéraire</strong><span>{plain(address[2])}</span></span></a>}
      </div>
    </div>
  </section>}
</Base>
