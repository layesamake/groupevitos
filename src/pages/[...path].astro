---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FormationCard from '../components/FormationCard.astro';
import FamilyFilter from '../components/FamilyFilter.astro';
import Tarifs from '../components/Tarifs.astro';
import { familiesOf, getContent, pageBySlug, pathOf, type Entry } from '../lib/wordpress';
import { featured, image, plain, publicLinks } from '../lib/html';
import { figures, listItems } from '../lib/extract';
import { POLES, contactsFor, dossierFor, identityLines, ofType, tarifsFor, telHref } from '../lib/referentiel';
export async function getStaticPaths() {
  const { pages } = await getContent();
  return pages.filter(page => page.slug !== 'accueil' && pathOf(page) !== '/').map(page => ({ params: { path: pathOf(page).replace(/^\/|\/$/g, '') }, props: { page } }));
}
const { page } = Astro.props as { page: Entry };
const { media, pages, formations, tarifs, dossiers, coordonnees, partenaires, identite } = await getContent();
const html = publicLinks(page.content.rendered);
const byFile = (url: string) => media[url.split('/').pop()!];
const slug = page.slug;
// Photo de bandeau : image mise en avant de la page, sinon une photo de l'établissement
const heroFile = ({ admission: 'hero-admission.webp', inscription: 'hero-admission.webp', galeries: 'graduation-1.jpg', 'a-propos': 'F89A7166-scaled-1.avif', universite: 'formations-hero.avif', lycee: 'F89A7161-scaled-1.avif', itp: 'F89A7166-scaled-1.avif', partenaires: 'graduation-1.jpg' } as Record<string, string>)[slug];
const hero = featured(page, '') ?? (heroFile ? image(media[heroFile], '') : undefined);

const pole = POLES.find(p => p.slug === slug);
const isPole = !!pole;
const blocks = POLES.map(p => ({ pole: p, dossier: dossierFor(dossiers, p.slug), ...tarifsFor(tarifs, p.slug), phones: contactsFor(coordonnees, p.slug) }));
const mine = pole ? blocks.find(b => b.pole.slug === pole.slug)! : undefined;
const email = ofType(coordonnees, 'email')[0];
const socials = ofType(coordonnees, 'reseau');
const phonesAll = ofType(coordonnees, 'telephone');
const address = ofType(coordonnees, 'adresse')[0]?.meta.valeur ?? identite.adresse;

// Galerie : catégories tirées des légendes
const photos = slug === 'galeries' ? figures(html) : [];
const categories = [...new Set(photos.map(photo => photo.caption).filter(Boolean))];

// Contacts : lien d'itinéraire et plan saisis dans la page WordPress
const contactPage = pageBySlug(pages, 'contacts');
const route = contactPage?.content.rendered.match(/<p[^>]*>[^<]*<a[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/)?.[1];
const map = contactPage?.content.rendered.match(/<iframe[^>]*src="([^"]+)"/)?.[1];
const pieces = (block?: { dossier?: { meta: { pieces: string } } }) => listItems(block?.dossier?.meta.pieces ?? '').map(item => item.text);
const reperes = identityLines(identite.reperes).map(line => { const [year, ...text] = line.split('|'); return { year: year.trim(), text: text.join('|').trim() }; });
---
<Base title={page.title.rendered} description={plain(page.excerpt.rendered) || plain(page.content.rendered).slice(0, 160)} image={hero?.src}>
  <PageHero title={page.title.rendered} img={hero} kicker={isPole ? 'Groupe VITO S.' : undefined} />

  {slug === 'galeries' && photos.length ? (
    <section class="section">
      <div class="wrap">
        {categories.length > 1 && <div class="filters" role="group" aria-label="Filtrer les photos" data-gallery-filter>
          <button type="button" aria-pressed="true" data-category="">Toutes</button>
          {categories.map(category => <button type="button" aria-pressed="false" data-category={category}>{category}</button>)}
        </div>}
        <div class="gallery">{photos.map((photo, index) => <figure data-category={photo.caption}><Picture img={image(byFile(photo.src), photo.alt || photo.caption)} sizes={index % 5 === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} />{photo.caption && <figcaption>{photo.caption}</figcaption>}</figure>)}</div>
      </div>
    </section>
  ) : isPole && mine ? <>
    <section class="section">
      <div class="wrap">
        <article class="prose" set:html={html} />
        {slug === 'universite' && <p class="durations-line"><strong>DUT · Licence · Master</strong></p>}
      </div>
    </section>
    {slug === 'universite' && formations.length > 0 && <section class="section section--white" id="catalogue">
      <div class="wrap">
        <div class="section__head"><Eyebrow>Catalogue</Eyebrow><h2>{formations.length} formations</h2></div>
        <FamilyFilter target="#cartes-universite" families={familiesOf(formations)} />
        <div class="cards cards--grid" id="cartes-universite">{formations.map((formation, index) => <FormationCard formation={formation} index={index} />)}</div>
      </div>
    </section>}
    <section class="section" id="admission">
      <div class="wrap pole-block">
        <div class="section__head"><Eyebrow>Admission</Eyebrow><h2>Pièces à fournir</h2></div>
        {pieces(mine).length > 0 ? <ul class="checklist">{pieces(mine).map(doc => <li><Icon name="check" />{doc}</li>)}</ul> : <p>Contactez le service admission pour connaître le dossier à fournir.</p>}
        {mine.dossier?.meta.note && <div class="note" set:html={mine.dossier.meta.note} />}
        {mine.dossier?.meta.annee && <p class="note">{mine.dossier.meta.annee}</p>}
      </div>
    </section>
    <section class="section section--white" id="tarifs">
      <div class="wrap">
        <div class="section__head"><Eyebrow>Frais</Eyebrow><h2>Tarifs</h2></div>
        <Tarifs scolarite={mine.scolarite} complements={mine.complements} university={slug === 'universite'} />
      </div>
    </section>
    <section class="section section--cobalt">
      <div class="wrap contact">
        <h2>Contacter {pole!.short === 'Université' ? 'l’Université' : `le ${pole!.short}`}</h2>
        <div class="contact__list">
          {mine.phones.map(c => <a class="contact__item" href={telHref(c.meta.valeur)}><Icon name="phone" /><span><strong>Appeler {c.meta.usage}</strong><span>{c.meta.valeur}</span></span></a>)}
          {email && <a class="contact__item" href={`mailto:${email.meta.valeur}`}><Icon name="mail" /><span><strong>Écrire un e-mail</strong><span>{email.meta.valeur}</span></span></a>}
        </div>
      </div>
    </section>
  </> : slug === 'admission' ? <>
    <section class="section">
      <div class="wrap admission"><article class="prose" set:html={html} /></div>
    </section>
    {blocks.map(block => <section class="section" class:list={{ 'section--white': block.pole.slug === 'lycee' }} id={block.pole.slug}>
      <div class="wrap pole-block">
        <div class="section__head"><Eyebrow>{block.pole.short}</Eyebrow><h2>{block.pole.name}</h2></div>
        {pieces(block).length > 0 && <><h3>Pièces à fournir{block.dossier?.meta.annee && ` — ${block.dossier.meta.annee}`}</h3><ul class="checklist">{pieces(block).map(doc => <li><Icon name="check" />{doc}</li>)}</ul></>}
        {block.dossier?.meta.note && <div class="note" set:html={block.dossier.meta.note} />}
        <h3>Tarifs</h3>
        <Tarifs scolarite={block.scolarite} complements={block.complements} university={block.pole.slug === 'universite'} />
        <p><a class="btn btn--outline" href={block.pole.path}>Tout sur le {block.pole.short === 'Université' ? 'pôle Université' : `pôle ${block.pole.short}`} →</a></p>
      </div>
    </section>)}
  </> : slug === 'inscription' ? <>
    <section class="section">
      <div class="wrap"><article class="prose" set:html={html} />
        <div class="poles">{blocks.map(block => <article class="pole">
          <h3>{block.pole.name}</h3><p>{block.pole.lead}</p>
          {block.phones[0] && <a href={telHref(block.phones[0].meta.valeur)}>{block.phones[0].meta.valeur}</a>}
          <a class="pole__more" href={`/admission/#${block.pole.slug}`}>Dossier et tarifs →</a>
        </article>)}</div>
      </div>
    </section>
  </> : slug === 'partenaires' ? <>
    <section class="section">
      <div class="wrap">
        <article class="prose" set:html={html} />
        {partenaires.length > 0 && <ul class="partner-names">{partenaires.map(p => { const logo = featured(p, p.title.rendered); return <li>{logo && <Picture img={logo} sizes="150px" />}<span set:html={p.title.rendered} />{p.meta.sigle && !logo && <small>{p.meta.sigle}</small>}{p.meta.note && p.meta.note.startsWith('Campus') && <small>{p.meta.note}</small>}</li>; })}</ul>}
      </div>
    </section>
  </> : slug === 'contacts' ? <>
    <section class="section">
      <div class="wrap pole-block">
        <div class="contact__list">
          {phonesAll.map(c => <a class="contact__item" href={telHref(c.meta.valeur)}><Icon name="phone" /><span><strong>{c.meta.usage}</strong><span>{c.meta.valeur}</span></span></a>)}
          {email && <a class="contact__item" href={`mailto:${email.meta.valeur}`}><Icon name="mail" /><span><strong>Écrire un e-mail</strong><span>{email.meta.valeur}</span></span></a>}
          <a class="contact__item" href={route ?? '#'}><Icon name="pin" /><span><strong>Itinéraire</strong><span>{address}</span></span></a>
        </div>
        {socials.length > 0 && <div class="socials">{socials.map(c => <a href={c.meta.valeur} rel="noopener" target="_blank">{c.meta.usage}</a>)}</div>}
        {map && <iframe class="map" src={map} title="Plan d’accès à l’Institut VITO S." loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>}
      </div>
    </section>
  </> : slug === 'a-propos' ? <>
    <section class="section">
      <div class="wrap pole-block">
        <p class="motto">{identite.devise}</p>
        <article class="prose" set:html={html} />
        <p class="note">{identite.reconnaissance}</p>
        {reperes.length > 0 && <><h3>Repères</h3><ul class="timeline">{reperes.map(r => <li><strong>{r.year || '—'}</strong><span>{r.text}</span></li>)}</ul></>}
        <p>{identityLines(identite.signatures).join(' · ')}</p>
      </div>
    </section>
  </> : (
    <section class="section">
      <div class="wrap"><article class="prose" set:html={html} /></div>
    </section>
  )}

  {categories.length > 1 && <script>
    const group = document.querySelector<HTMLElement>('[data-gallery-filter]');
    const buttons = group?.querySelectorAll<HTMLButtonElement>('button') ?? [];
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      document.querySelectorAll<HTMLElement>('.gallery figure').forEach(figure => { figure.hidden = !!button.dataset.category && figure.dataset.category !== button.dataset.category; });
    }));
  </script>}
</Base>
