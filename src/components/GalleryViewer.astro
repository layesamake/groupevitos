---
// Visionneuse plein écran des galeries : navigue parmi les photos visibles du conteneur `[data-gallery]` (donc de la catégorie filtrée).
// Chaque photo est un bouton `.gallery__open` (data-full, data-alt, data-caption, data-id facultatif pour le lien direct).
---
<dialog class="lb" aria-label="Visionneuse de photos">
  <div class="lb__bar">
    <p class="lb__count" aria-live="polite"></p>
    <div class="lb__tools">
      <button type="button" class="lb__btn lb__play" aria-pressed="false" aria-label="Lancer le diaporama"><svg class="lb__i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg><svg class="lb__i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg></button>
      <button type="button" class="lb__btn lb__link" aria-label="Copier le lien de cette photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1" /></svg></button>
      <button type="button" class="lb__btn lb__close" aria-label="Fermer la visionneuse"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
    </div>
  </div>
  <button type="button" class="lb__btn lb__nav lb__prev" aria-label="Photo précédente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
  <figure class="lb__stage">
    <img class="lb__img" alt="" decoding="async" />
    <figcaption class="lb__caption"></figcaption>
    <p class="lb__status" role="status" aria-live="polite"></p>
  </figure>
  <button type="button" class="lb__btn lb__nav lb__next" aria-label="Photo suivante"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
  <span class="lb__progress" aria-hidden="true"></span>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lb');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.lb__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lb__caption')!;
    const count = dialog.querySelector<HTMLElement>('.lb__count')!;
    const status = dialog.querySelector<HTMLElement>('.lb__status')!;
    const nav = dialog.querySelectorAll<HTMLElement>('.lb__nav');
    const play = dialog.querySelector<HTMLButtonElement>('.lb__play')!;
    const link = dialog.querySelector<HTMLButtonElement>('.lb__link')!;
    const progress = dialog.querySelector<HTMLElement>('.lb__progress')!;
    const DELAY = 4000;
    let items: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;
    let timer = 0;
    let playing = false;

    const collect = (from: HTMLElement) => {
      const scope = from.closest<HTMLElement>('[data-gallery]') ?? document;
      items = [...scope.querySelectorAll<HTMLElement>('.gallery__open')].filter(button => !button.closest('figure')?.hidden);
    };
    const preload = (position: number) => { const full = items[(position + items.length) % items.length]?.dataset.full; if (full) new Image().src = full; };
    const say = (text: string) => { status.textContent = text; };

    function schedule() {
      window.clearTimeout(timer);
      progress.classList.remove('is-running');
      if (!playing || items.length < 2) return;
      void progress.offsetWidth;
      progress.classList.add('is-running');
      timer = window.setTimeout(() => show(index + 1), DELAY);
    }
    function setPlaying(value: boolean) {
      playing = value && items.length > 1;
      play.setAttribute('aria-pressed', String(playing));
      play.setAttribute('aria-label', playing ? 'Mettre le diaporama en pause' : 'Lancer le diaporama');
      dialog!.classList.toggle('is-playing', playing);
      say(playing ? 'Diaporama en cours' : '');
      schedule();
    }

    function show(position: number) {
      if (!items.length) return;
      index = (position + items.length) % items.length;
      const button = items[index];
      const full = button.dataset.full ?? '';
      if (img.getAttribute('src') !== full) {
        img.classList.add('is-loading');
        img.onload = () => img.classList.remove('is-loading');
        img.onerror = () => img.classList.remove('is-loading');
        img.src = full;
        if (img.complete && img.naturalWidth) img.classList.remove('is-loading');
      }
      img.alt = button.dataset.alt ?? '';
      const category = button.closest('figure')?.dataset.category;
      caption.textContent = [category, button.dataset.caption && button.dataset.caption !== category ? button.dataset.caption : ''].filter(Boolean).join(' — ');
      count.textContent = `${index + 1} / ${items.length}`;
      nav.forEach(control => { control.hidden = items.length < 2; });
      play.hidden = items.length < 2;
      link.hidden = !button.dataset.id;
      if (button.dataset.id) history.replaceState(null, '', `#photo-${button.dataset.id}`);
      preload(index + 1); preload(index - 1);
      schedule();
    }

    function open(button: HTMLElement) {
      collect(button);
      const position = items.indexOf(button);
      if (position < 0) return;
      opener = button;
      img.removeAttribute('src');
      setPlaying(false);
      show(position);
      document.documentElement.classList.add('lb-open');
      dialog!.showModal();
    }

    document.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('.gallery__open');
      if (button) open(button);
    });
    dialog.querySelector('.lb__close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb__prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb__next')!.addEventListener('click', () => show(index + 1));
    play.addEventListener('click', () => setPlaying(!playing));
    link.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(location.href); say('Lien copié'); } catch { say('Copie impossible : copiez l’adresse du navigateur'); }
    });
    // Clic sur le fond sombre : fermeture
    dialog.addEventListener('click', event => { const cible = event.target as HTMLElement; if (cible === dialog || cible.classList.contains('lb__stage')) dialog.close(); });
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
      else if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
      else if (event.key === 'Home') { event.preventDefault(); show(0); }
      else if (event.key === 'End') { event.preventDefault(); show(items.length - 1); }
      else if (event.key === ' ' && (event.target as HTMLElement) === dialog) { event.preventDefault(); setPlaying(!playing); }
    });
    dialog.addEventListener('close', () => {
      setPlaying(false);
      document.documentElement.classList.remove('lb-open');
      if (/^#photo-/.test(location.hash)) history.replaceState(null, '', location.pathname + location.search);
      opener?.focus();
    });
    // Le diaporama se met en pause quand l'onglet n'est plus visible
    document.addEventListener('visibilitychange', () => { if (document.hidden && playing) setPlaying(false); });

    // Balayage du doigt : photo suivante / précédente
    let startX = 0;
    let startY = 0;
    dialog.addEventListener('touchstart', event => { startX = event.touches[0].clientX; startY = event.touches[0].clientY; }, { passive: true });
    dialog.addEventListener('touchend', event => {
      const dx = event.changedTouches[0].clientX - startX;
      const dy = event.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // Lien direct vers une photo : /galeries/#photo-4
    const direct = /^#photo-(\d+)$/.exec(location.hash);
    if (direct) {
      const target = document.querySelector<HTMLElement>(`.gallery__open[data-id="${direct[1]}"]`);
      if (target) {
        if (target.closest('figure')?.hidden) document.querySelector<HTMLButtonElement>('[data-gallery-filter] button[data-category=""]')?.click();
        window.requestAnimationFrame(() => { target.scrollIntoView({ block: 'center' }); open(target); });
      }
    }
  }
</script>
