---
import type { Formation } from '../lib/wordpress';
import { featured } from '../lib/html';
const { formation } = Astro.props as { formation: Formation };
const image = featured(formation);
---
<a class="card" href={`/formations/${formation.slug}/`}>
  {image?.source_url && <img src={image.source_url} alt="" loading="lazy" decoding="async" />}
  <div class="card__body">
    {formation.meta.niveau && <p class="card__tag">{formation.meta.niveau}</p>}
    <h3 set:html={formation.title.rendered} />
    {formation.meta.duree && <p class="card__meta">Durée : {formation.meta.duree}</p>}
    <span class="card__more">Voir la formation →</span>
  </div>
</a>
