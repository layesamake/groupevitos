---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FormationCard from '../../components/FormationCard.astro';
import FamilyFilter from '../../components/FamilyFilter.astro';
import { familiesOf, getContent } from '../../lib/wordpress';
import { image } from '../../lib/html';
const { formations, media } = await getContent();
const description = 'Le catalogue de l’Université VITO S. : gestion, finance, droit, marketing, logistique, communication, numérique et développement.';
const hero = image(media['formations-hero.avif'], 'Étudiants de l’Institut VITO S. en cours');
---
<Base title="Nos formations" description={description} image={hero?.src}>
  <PageHero title="Nos formations" lead={description} img={hero} />
  <section class="section">
    <div class="wrap">
      {formations.length ? <>
        <p class="note">Le diplôme (DUT, Licence ou Master) et les conditions d’accès de chaque formation sont confirmés par l’admission au fur et à mesure de leur validation par l’établissement.</p>
        <FamilyFilter target="#cartes" families={familiesOf(formations)} />
        <div class="cards cards--grid" id="cartes">{formations.map((formation, index) => <FormationCard formation={formation} index={index} />)}</div>
      </> : <p>Le catalogue des formations sera bientôt disponible.</p>}
    </div>
  </section>
</Base>
