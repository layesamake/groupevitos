---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FormationCard from '../components/FormationCard.astro';
import FamilyFilter from '../components/FamilyFilter.astro';
import Tarifs from '../components/Tarifs.astro';
import GalleryViewer from '../components/GalleryViewer.astro';
import ContactForm from '../components/ContactForm.astro';
import CandidatureForm from '../components/CandidatureForm.astro';
import AdmissionForm from '../components/AdmissionForm.astro';
import { familiesOf, getContent, pageBySlug, pathOf, type Entry } from '../lib/wordpress';
import { featured, image, plain, publicLinks } from '../lib/html';
import { figures, listItems } from '../lib/extract';
import { POLES, contactsFor, dossierFor, identityLines, ofType, tarifsFor, telHref } from '../lib/referentiel';
export async function getStaticPaths() {
  const { pages } = await getContent();
  return pages.filter(page => page.slug !== 'accueil' && pathOf(page) !== '/').map(page => ({ params: { path: pathOf(page).replace(/^\/|\/$/g, '') }, props: { page } }));
}
const { page } = Astro.props as { page: Entry };
const { media, pages, formations, tarifs, dossiers, coordonnees, partenaires, identite } = await getContent();
const html = publicLinks(page.content.rendered);
const byFile = (url: string) => media[url.split('/').pop()!];
const slug = page.slug;
// Photo de bandeau : image mise en avant de la page, sinon une photo de l'établissement
const heroFile = ({ admission: 'etudiants-admission.webp', inscription: 'hero-admission.webp', galeries: 'graduation-1.jpg', 'a-propos': 'etudiants-complices.webp', universite: 'etudiants-numerique.webp', lycee: 'etudiants-lycee.webp', itp: 'etudiants-itp.webp', partenaires: 'etudiants-partenaires.webp', enseignants: 'etudiants-complices.webp' } as Record<string, string>)[slug];
const cutout = !featured(page, '') && ['universite', 'a-propos', 'lycee', 'itp', 'admission', 'partenaires', 'enseignants'].includes(slug);
const hero = featured(page, '') ?? (heroFile ? image(media[heroFile], '') : undefined);

const pole = POLES.find(p => p.slug === slug);
const isPole = !!pole;
const blocks = POLES.map(p => ({ pole: p, dossier: dossierFor(dossiers, p.slug), ...tarifsFor(tarifs, p.slug), phones: contactsFor(coordonnees, p.slug) }));
const mine = pole ? blocks.find(b => b.pole.slug === pole.slug)! : undefined;
const email = ofType(coordonnees, 'email')[0];
const socials = ofType(coordonnees, 'reseau');
const phonesAll = ofType(coordonnees, 'telephone');
const address = ofType(coordonnees, 'adresse')[0]?.meta.valeur ?? identite.adresse;

// Galerie : catégories tirées des légendes
const photos = slug === 'galeries' ? figures(html) : [];
const categories = [...new Set(photos.map(photo => photo.caption).filter(Boolean))];

// Contacts : lien d'itinéraire et plan saisis dans la page WordPress
const contactPage = pageBySlug(pages, 'contacts');
const route = contactPage?.content.rendered.match(/<p[^>]*>[^<]*<a[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/)?.[1];
const map = contactPage?.content.rendered.match(/<iframe[^>]*src="([^"]+)"/)?.[1];
const pieces = (block?: { dossier?: { meta: { pieces: string } } }) => listItems(block?.dossier?.meta.pieces ?? '').map(item => item.text);
// Page « Le Groupe » : le texte saisi dans WordPress est découpé par intertitres pour être mis en forme par blocs
const about = slug === 'a-propos' ? (() => {
  const body = html.replace(/<p[^>]*>\s*<strong>([^<]+)<\/strong>\s*<\/p>\s*$/, '');
  const tagline = plain(html.match(/<p[^>]*>\s*<strong>([^<]+)<\/strong>\s*<\/p>\s*$/)?.[1] ?? '');
  const intro = body.split(/<h3/)[0];
  const blocks = [...body.matchAll(/<h3[^>]*>([\s\S]*?)<\/h3>([\s\S]*?)(?=<h3|$)/g)].map(match => ({ title: plain(match[1]), html: match[2] }));
  const find = (pattern: RegExp) => blocks.find(block => pattern.test(block.title));
  return { intro, tagline, blocks, poles: find(/p[ôo]les/i), histoire: find(/tablissement|bamako/i), pratique: find(/formation|pratique/i), implantations: find(/implantation/i) };
})() : null;
// Page Contact : numéros regroupés par service (le standard d'abord), numéro principal mis en avant
const phoneGroups = [...phonesAll.reduce((groups, c) => groups.set(c.meta.usage, [...(groups.get(c.meta.usage) ?? []), c]), new Map<string, typeof phonesAll>())]
  .sort((x, y) => Number(/standard/i.test(y[0])) - Number(/standard/i.test(x[0])));
const mainPhone = phonesAll.find(c => /standard/i.test(c.meta.usage)) ?? phonesAll[0];
// Mot du Promoteur Directeur Général (page « Le Groupe »)
const motPromoteur = {
  titre: 'Mot du Promoteur Directeur Général',
  phrase: 'Ensemble, bâtissons les talents de demain.',
  paragraphes: [
    'Dans un monde de plus en plus complexe et compétitif à la fois, et parfois non dénué de contradictions, où l’information est à la fois universelle et accessible, savoir ne suffit plus… Il est indispensable d’être excellent, à même de comprendre, d’analyser, d’interpréter, de juger et d’anticiper.',
    'C’est pourquoi le programme des enseignements de l’Institut VITO S. permet d’acquérir, outre les savoir-faire du management, une culture générale internationale indispensable à votre réussite professionnelle.',
    'Ici, nous aidons nos étudiants à mettre en évidence leurs qualités et à développer leurs compétences. En chaque être humain subsistent des qualités et des compétences, mais comment en profiter ? Voilà toute la réponse que vous donne notre enseignement.',
    'Rejoindre l’Institut VITO S., c’est faire le choix d’un groupe expérimenté, à taille humaine, soucieux de l’avenir de ses étudiants et qui affiche d’excellents résultats grâce à une équipe enseignante de haut niveau. Choisir l’Institut VITO S., c’est choisir à coup sûr l’avance rapide vers une carrière réussie.',
  ],
  signature: 'M. Fousseynou TANDINA',
  fonction: 'Promoteur Directeur Général',
};
const poleLink = (title: string) => /universit/i.test(title) ? '/universite/' : /lyc/i.test(title) ? '/lycee/' : /itp|technique/i.test(title) ? '/itp/' : '';
const reperes = identityLines(identite.reperes).map(line => { const [year, ...text] = line.split('|'); return { year: year.trim(), text: text.join('|').trim() }; });
---
<Base title={page.title.rendered} description={plain(page.excerpt.rendered) || plain(page.content.rendered).slice(0, 160)} image={hero?.src}>
  <PageHero title={page.title.rendered} img={hero} cutout={cutout} kicker={isPole ? 'Groupe VITO S.' : undefined} />

  {slug === 'galeries' && photos.length ? (
    <section class="section">
      <div class="wrap">
        {categories.length > 1 && <div class="filters" role="group" aria-label="Filtrer les photos" data-gallery-filter>
          <button type="button" aria-pressed="true" data-category="">Toutes <span class="filters__n">{photos.length}</span></button>
          {categories.map(category => <button type="button" aria-pressed="false" data-category={category}>{category} <span class="filters__n">{photos.filter(photo => photo.caption === category).length}</span></button>)}
        </div>}
        <div class="gallery" data-gallery>{photos.map((photo, index) => {
          const img = image(byFile(photo.src), photo.alt || photo.caption);
          const label = photo.alt || photo.caption || 'photo';
          return <figure data-category={photo.caption} style={`--i:${index % 8}`}>
            <button type="button" class="gallery__open" data-id={index + 1} data-full={img?.src ?? photo.src} data-alt={img?.alt ?? label} data-caption={photo.caption} aria-label={`Agrandir : ${label}`}>
              <Picture img={img} sizes={index % 5 === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} />
              <span class="gallery__zoom" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.2-4.2M11 8.5v5M8.5 11h5" /></svg></span>
            </button>
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>;
        })}</div>
        <GalleryViewer />
      </div>
    </section>
  ) : isPole && mine ? <>
    <section class="section">
      <div class="wrap">
        <article class="prose" set:html={html} />
        {slug === 'universite' && <p class="durations-line"><strong>DUT · Licence · Master</strong></p>}
      </div>
    </section>
    {slug === 'universite' && formations.length > 0 && <section class="section section--white" id="catalogue">
      <div class="wrap">
        <div class="section__head"><Eyebrow>Catalogue</Eyebrow><h2>{formations.length} formations</h2></div>
        <FamilyFilter target="#cartes-universite" families={familiesOf(formations)} />
        <div class="cards cards--grid" id="cartes-universite">{formations.map((formation, index) => <FormationCard formation={formation} index={index} />)}</div>
      </div>
    </section>}
    <section class="section" id="admission">
      <div class="wrap pole-block">
        <div class="section__head"><Eyebrow>Admission</Eyebrow><h2>Pièces à fournir</h2></div>
        {pieces(mine).length > 0 ? <ul class="checklist">{pieces(mine).map(doc => <li><Icon name="check" />{doc}</li>)}</ul> : <p>Contactez le service admission pour connaître le dossier à fournir.</p>}
        {mine.dossier?.meta.note && <div class="note" set:html={mine.dossier.meta.note} />}
        {mine.dossier?.meta.annee && <p class="note">{mine.dossier.meta.annee}</p>}
      </div>
    </section>
    <section class="section section--white" id="tarifs">
      <div class="wrap">
        <div class="section__head"><Eyebrow>Frais</Eyebrow><h2>Tarifs</h2></div>
        <Tarifs scolarite={mine.scolarite} complements={mine.complements} university={slug === 'universite'} />
      </div>
    </section>
    <section class="section section--cobalt">
      <div class="wrap contact">
        <h2>Contacter {pole!.short === 'Université' ? 'l’Université' : `le ${pole!.short}`}</h2>
        <div class="contact__list">
          {mine.phones.map(c => <a class="contact__item" href={telHref(c.meta.valeur)}><Icon name="phone" /><span><strong>Appeler {c.meta.usage}</strong><span>{c.meta.valeur}</span></span></a>)}
          {email && <a class="contact__item" href={`mailto:${email.meta.valeur}`}><Icon name="mail" /><span><strong>Écrire un e-mail</strong><span>{email.meta.valeur}</span></span></a>}
        </div>
      </div>
    </section>
  </> : slug === 'admission' ? <>
    <section class="section">
      <div class="wrap admission"><article class="prose" set:html={html} /></div>
    </section>
    {blocks.map(block => <section class="section" class:list={{ 'section--white': block.pole.slug === 'lycee' }} id={block.pole.slug}>
      <div class="wrap pole-block">
        <div class="section__head"><Eyebrow>{block.pole.short}</Eyebrow><h2>{block.pole.name}</h2></div>
        {pieces(block).length > 0 && <><h3>Pièces à fournir{block.dossier?.meta.annee && ` — ${block.dossier.meta.annee}`}</h3><ul class="checklist">{pieces(block).map(doc => <li><Icon name="check" />{doc}</li>)}</ul></>}
        {block.dossier?.meta.note && <div class="note" set:html={block.dossier.meta.note} />}
        <h3>Tarifs</h3>
        <Tarifs scolarite={block.scolarite} complements={block.complements} university={block.pole.slug === 'universite'} />
        <p><a class="btn btn--outline" href={block.pole.path}>Tout sur le {block.pole.short === 'Université' ? 'pôle Université' : `pôle ${block.pole.short}`} →</a></p>
      </div>
    </section>)}
  </> : slug === 'inscription' ? <>
    <section class="section">
      <div class="wrap"><article class="prose" set:html={html} />
        <div class="poles">{blocks.map(block => <article class="pole">
          <h3>{block.pole.name}</h3><p>{block.pole.lead}</p>
          {block.phones[0] && <a href={telHref(block.phones[0].meta.valeur)}>{block.phones[0].meta.valeur}</a>}
          <a class="pole__more" href={`/admission/#${block.pole.slug}`}>Dossier et tarifs →</a>
        </article>)}</div>
        <h2 id="demande">Faire une demande d’admission</h2>
        <AdmissionForm />
      </div>
    </section>
  </> : slug === 'partenaires' ? <>
    <section class="section">
      <div class="wrap">
        <article class="prose" set:html={html} />
        {partenaires.length > 0 && <ul class="partner-names">{partenaires.map(p => { const logo = featured(p, p.title.rendered); return <li>{logo && <Picture img={logo} sizes="150px" />}<span set:html={p.title.rendered} />{p.meta.sigle && !logo && <small>{p.meta.sigle}</small>}{p.meta.note && p.meta.note.startsWith('Campus') && <small>{p.meta.note}</small>}</li>; })}</ul>}
      </div>
    </section>
  </> : slug === 'enseignants' ? <>
    <section class="section">
      <div class="wrap pole-block">
        <article class="prose" set:html={html} />
        <CandidatureForm />
      </div>
    </section>
  </> : slug === 'contacts' ? <>
    <section class="section contact-quick">
      <div class="wrap">
        <div class="section__head"><Eyebrow number="01">Nous joindre</Eyebrow><h2>Trois façons de nous contacter</h2></div>
        <ul class="quick">
          {mainPhone && <li class="quick__card quick__card--main">
            <Icon name="phone" size={28} /><h3>Appeler</h3><p>{mainPhone.meta.usage}</p>
            <a class="quick__big" href={telHref(mainPhone.meta.valeur)}>{mainPhone.meta.valeur}</a>
            <a class="quick__link" href="#numeros">Tous nos numéros ↓</a>
          </li>}
          <li class="quick__card">
            <Icon name="mail" size={28} /><h3>Écrire</h3><p>Nous répondons par e-mail</p>
            {email && <a class="quick__big quick__big--mail" href={`mailto:${email.meta.valeur}`}>{email.meta.valeur}</a>}
            <a class="quick__link" href="#message">Ou utilisez le formulaire ↓</a>
          </li>
          <li class="quick__card">
            <Icon name="pin" size={28} /><h3>Venir</h3><p>{address}</p>
            <a class="btn btn--night btn--small" href={route ?? '#plan'}>Itinéraire</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--white" id="message">
      <div class="wrap contact-grid">
        <div>
          <div class="section__head"><Eyebrow number="02">Écrivez-nous</Eyebrow><h2>Envoyez-nous un message</h2></div>
          <p class="contact-grid__lead">Admission, scolarité, partenariat… Dites-nous en quelques lignes ce dont vous avez besoin : nous vous répondons par e-mail.</p>
          <ContactForm />
        </div>
        <aside class="phone-book" id="numeros">
          <h2>Tous nos numéros</h2>
          {phoneGroups.map(([usage, numbers]) => <section class="phone-book__group">
            <h3>{usage}</h3>
            <ul>{numbers.map(c => <li><a href={telHref(c.meta.valeur)}><Icon name="phone" size={18} />{c.meta.valeur}</a></li>)}</ul>
          </section>)}
          {email && <section class="phone-book__group"><h3>E-mail</h3><ul><li><a href={`mailto:${email.meta.valeur}`}><Icon name="mail" size={18} />{email.meta.valeur}</a></li></ul></section>}
        </aside>
      </div>
    </section>

    <section class="section" id="plan">
      <div class="wrap">
        <div class="section__head"><Eyebrow number="03">Nous trouver</Eyebrow><h2>Venir à l’Institut</h2></div>
        <p class="contact-address"><Icon name="pin" size={20} /><span>{address}</span></p>
        {map && <iframe class="map" src={map} title="Plan d’accès à l’Institut VITO S." loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>}
        {socials.length > 0 && <div class="contact-social"><p>Suivez-nous</p><div class="socials">{socials.map(c => <a href={c.meta.valeur} rel="noopener" target="_blank">{c.meta.usage}</a>)}</div></div>}
      </div>
    </section>
  </> : slug === 'a-propos' ? (about && about.blocks.length >= 3 ? <>
    <section class="section about-intro">
      <div class="wrap about-intro__grid">
        <div>
          <Eyebrow number="01">Le Groupe</Eyebrow>
          <div class="about-lead" set:html={about.intro.replace(/<h2[^>]*>[\s\S]*?<\/h2>/, '')} />
          <p class="note">{identite.reconnaissance}</p>
        </div>
        <aside class="about-card">
          <img class="logo-institut" src="/logo-institut-vitos.webp" width="460" height="117" alt="Institut VITO S. — établissement privé d’enseignement secondaire et supérieur agréé par l’État" />
          <p class="motto">{identite.devise}</p>
          <ul class="about-facts">
            {reperes[0]?.year && <li><strong>{reperes[0].year}</strong><span>Création de l’Institut</span></li>}
            {about.poles && <li><strong>{listItems(about.poles.html).length}</strong><span>pôles d’enseignement</span></li>}
            <li><strong>Bamako</strong><span>Kalaban Coura, Mali</span></li>
          </ul>
        </aside>
      </div>
      <nav class="wrap about-nav" aria-label="Sur cette page">
        {about.poles && <a href="#poles">Nos pôles</a>}
        {about.histoire && <a href="#histoire">Notre histoire</a>}
        <a href="#mot">Le mot du Promoteur</a>
        {about.pratique && <a href="#pedagogie">Notre pédagogie</a>}
        {reperes.length > 0 && <a href="#reperes">Repères</a>}
        {about.implantations && <a href="#implantations">Implantations</a>}
      </nav>
    </section>

    {about.poles && <section class="section section--white" id="poles">
      <div class="wrap">
        <div class="section__head"><Eyebrow number="02">Trois pôles</Eyebrow><h2>{about.poles.title}</h2></div>
        <ul class="about-poles">{listItems(about.poles.html).map(item => {
          const href = poleLink(item.title);
          return <li class="about-pole">
            <Icon name="cap" size={26} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {href && <a href={href}>Découvrir <span aria-hidden="true">→</span></a>}
          </li>;
        })}</ul>
      </div>
    </section>}

    {about.histoire && <section class="section about-story-section" id="histoire">
      <div class="wrap about-story">
        <div class="about-story__content">
          <div class="section__head"><Eyebrow number="03">Notre histoire</Eyebrow><h2>{about.histoire.title}</h2></div>
          <div class="about-story__text" set:html={about.histoire.html} />
          <p class="about-story__who"><b>M. Fousseynou TANDINA</b><span>Promoteur Directeur Général</span></p>
        </div>
        <div class="about-founder">
          <img src="/fousseynou-tandina.webp" width="640" height="680" loading="lazy" decoding="async" alt="Portrait de M. Fousseynou Tandina, Promoteur Directeur Général de l’Institut VITO S." />
        </div>
      </div>
    </section>}

    <section class="section section--white about-word" id="mot">
      <div class="wrap about-word__grid">
        <div class="about-word__head">
          <Eyebrow number="04">Le mot du Promoteur</Eyebrow>
          <h2>{motPromoteur.titre}</h2>
          <p class="about-word__pull">{motPromoteur.phrase}</p>
        </div>
        <div class="about-word__text">
          {motPromoteur.paragraphes.map((paragraphe, i) => <p class={i === 0 ? 'about-word__lead' : undefined}>{paragraphe}</p>)}
          <p class="about-word__sign"><b>{motPromoteur.signature}</b><span>{motPromoteur.fonction}</span></p>
        </div>
      </div>
    </section>

    {about.pratique && <section class="section section--white" id="pedagogie">
      <div class="wrap">
        <div class="section__head"><Eyebrow number="05">Notre pédagogie</Eyebrow><h2>{about.pratique.title}</h2></div>
        <ul class="about-points">{listItems(about.pratique.html).map(item => <li><Icon name="check" size={22} /><span>{item.title ? <><strong>{item.title}</strong> — {item.text}</> : item.text}</span></li>)}</ul>
      </div>
    </section>}

    {reperes.length > 0 && <section class="section" id="reperes">
      <div class="wrap">
        <div class="section__head"><Eyebrow number="06">Repères</Eyebrow><h2>Notre parcours</h2></div>
        <ol class="about-timeline">{reperes.map(r => <li>{r.year && <strong>{r.year}</strong>}<span>{r.text}</span></li>)}</ol>
      </div>
    </section>}

    {about.implantations && <section class="section section--white" id="implantations">
      <div class="wrap about-where">
        <div class="section__head"><Eyebrow number="07">Où nous trouver</Eyebrow><h2>{about.implantations.title}</h2></div>
        <div class="about-where__card"><Icon name="pin" size={26} /><div set:html={about.implantations.html} /></div>
      </div>
    </section>}

    <section class="section section--night about-cta">
      <div class="wrap">
        {about.tagline && <p class="about-cta__tagline">{about.tagline}</p>}
        <p class="about-cta__sign">{identityLines(identite.signatures).join(' · ')}</p>
        <div class="about-cta__actions">
          <a class="btn btn--mango" href="/admission/">Faire une demande d’admission</a>
          <a class="btn btn--ghost" href="/contacts/">Nous contacter</a>
        </div>
      </div>
    </section>
  </> : <>
    <section class="section">
      <div class="wrap pole-block">
        <img class="logo-institut" src="/logo-institut-vitos.webp" width="460" height="117" alt="Institut VITO S. — établissement privé d’enseignement secondaire et supérieur agréé par l’État" />
        <p class="motto">{identite.devise}</p>
        <article class="prose" set:html={html} />
        <p class="note">{identite.reconnaissance}</p>
        {reperes.length > 0 && <><h3>Repères</h3><ul class="timeline">{reperes.map(r => <li><strong>{r.year || '—'}</strong><span>{r.text}</span></li>)}</ul></>}
        <p>{identityLines(identite.signatures).join(' · ')}</p>
      </div>
    </section>
  </>) : (
    <section class="section">
      <div class="wrap"><article class="prose" set:html={html} /></div>
    </section>
  )}

  {slug === 'galeries' && photos.length > 0 && <script>
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    const figures = [...(gallery?.querySelectorAll<HTMLElement>('figure') ?? [])];

    // Apparition échelonnée au défilement (sans animation si l'utilisateur la désactive)
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const observer = !calm && 'IntersectionObserver' in window
      ? new IntersectionObserver(entries => entries.forEach(entry => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer?.unobserve(entry.target); }
        }), { rootMargin: '0px 0px -8% 0px' })
      : null;
    const reveal = () => {
      if (!observer) return;
      figures.forEach(figure => { figure.classList.remove('is-visible'); observer.unobserve(figure); if (!figure.hidden) observer.observe(figure); });
    };
    if (observer) { gallery?.classList.add('is-ready'); reveal(); }

    // Filtre par catégorie
    const group = document.querySelector<HTMLElement>('[data-gallery-filter]');
    const buttons = group?.querySelectorAll<HTMLButtonElement>('button') ?? [];
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      figures.forEach(figure => { figure.hidden = !!button.dataset.category && figure.dataset.category !== button.dataset.category; });
      reveal();
    }));
  </script>}
</Base>
