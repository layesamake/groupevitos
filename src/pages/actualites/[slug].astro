---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getContent, type Entry } from '../../lib/wordpress';
import { featured, formatDate, plain, publicLinks } from '../../lib/html';
export async function getStaticPaths() {
  const { posts } = await getContent();
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Entry };
const img = featured(post);
---
<Base title={post.title.rendered} description={plain(post.excerpt.rendered)} image={img?.src}>
  <PageHero title={post.title.rendered} kicker={formatDate(post.date)} img={img} className="page-hero--article" />
  <section class="section">
    <div class="wrap">
      <a class="back" href="/actualites/">← Actualités</a>
      <article class="prose" set:html={publicLinks(post.content.rendered)} />
    </div>
  </section>
</Base>
