---
// Bandeau de page : photo en fond (optionnelle) assombrie, titre, texte et actions.
interface Props { title: string; lead?: string; image?: string; size?: 'large' | 'small'; kicker?: string }
const { title, lead, image, size = 'small', kicker } = Astro.props;
---
<section class:list={['hero', `hero--${size}`]}>
  {image && <img class="hero__image" src={image} alt="" fetchpriority="high" />}
  <div class="wrap hero__inner">
    {kicker && <p class="hero__kicker" set:html={kicker} />}
    <h1 set:html={title} />
    {lead && <p class="hero__lead" set:html={lead} />}
    <slot />
  </div>
</section>
