---
import '@fontsource/bricolage-grotesque/latin-800.css';
import fontUrl from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getContent, pageBySlug, pathOf } from '../lib/wordpress';
import { image, plain } from '../lib/html';
import { ofType, telHref } from '../lib/referentiel';
import { institut } from '../lib/institut';
interface Props {
  title?: string; description?: string; image?: string;
  // Barre du bas sur mobile : navigation (par défaut) ou appel à l'action (fiches formation)
  cta?: { label: string; href: string };
}
const { cta } = Astro.props;
const { site, pages, coordonnees, media, identite } = await getContent();
const title = Astro.props.title ? `${plain(Astro.props.title)} | ${plain(site.name)}` : `${plain(site.name)} — ${plain(site.description)}`;
const description = plain(Astro.props.description || site.description || site.name);
const page = (slug: string) => pageBySlug(pages, slug);
const entry = (slug: string, label: string, icon: string, path?: string) => page(slug) || path ? { path: path ?? pathOf(page(slug)!), label, icon } : null;
const nav = [
  entry('universite', 'Université', 'cap'),
  entry('lycee', 'Lycée', 'cap'),
  entry('itp', 'ITP', 'cap'),
  entry('admission', 'Admissions', 'file'),
  entry('galeries', 'Galerie', 'image'),
  entry('a-propos', 'Le Groupe', 'home'),
  entry('contacts', 'Contact', 'phone'),
].filter(Boolean) as { path: string; label: string; icon: 'cap' | 'file' | 'image' | 'home' | 'phone' }[];
const tabLabels = ['/universite/', '/admission/', '/a-propos/', '/contacts/'];
const tabs = [{ path: '/', label: 'Accueil', icon: 'home' as const }, ...nav.filter(item => tabLabels.includes(item.path))];
const signup = page('inscription');
const phones = ofType(coordonnees, 'telephone');
const phone = phones[0] && { href: telHref(phones[0].meta.valeur), text: phones[0].meta.valeur };
const email = ofType(coordonnees, 'email')[0]?.meta.valeur;
const socials = ofType(coordonnees, 'reseau');
const current = (path: string) => (path === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(path)) ? 'page' : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = Astro.props.image ?? image(media['etudiants.avif'])?.src;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08065B" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://admin.groupevitos.com" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body class:list={{ 'has-cta': cta }}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="header">
      <div class="wrap header__inner">
        <a class="brand" href="/" aria-label={`${plain(site.name)} — accueil`}>
          <img class="brand__logo" src="/symbole-ivs.svg" width="46" height="33" alt="" />
          <span class="brand__name">{institut.short}</span>
        </a>
        <nav class="header__nav" aria-label="Navigation principale">
          {nav.map(item => <a href={item.path} aria-current={current(item.path)}>{item.label}</a>)}
        </nav>
        <div class="header__actions">
          {phone && <a class="header__phone" href={phone.href}>{phone.text}</a>}
          {signup && <a class="btn btn--mango btn--small" href={pathOf(signup)}>S’inscrire</a>}
        </div>
      </div>
    </header>

    <main id="contenu"><slot /></main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <img class="brand__logo" src="/symbole-ivs.svg" width="46" height="33" alt="" />
          <strong set:html={site.name} />
          <p>{identite.devise}</p>
        </div>
        <ul class="footer__links">{[...nav, ...(page('partenaires') ? [{ path: pathOf(page('partenaires')!), label: 'Partenaires' }] : [])].map(item => <li><a href={item.path}>{item.label}</a></li>)}</ul>
        <ul class="footer__links">
          {phones.slice(0, 4).map(c => <li><a href={telHref(c.meta.valeur)}>{c.meta.usage} : {c.meta.valeur}</a></li>)}
          {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
          {socials.map(c => <li><a href={c.meta.valeur} rel="noopener" target="_blank">{c.meta.usage}</a></li>)}
        </ul>
      </div>
      <p class="wrap footer__legal">{institut.agrement} · © {new Date().getFullYear()} <span set:html={site.name} /></p>
    </footer>

    {cta ? (
      <div class="bottom-bar bottom-bar--cta">
        <a class="btn btn--mango" href={cta.href}>{cta.label}</a>
        {phone && <a class="bottom-bar__call" href={phone.href} aria-label={`Appeler le ${phone.text}`}><Icon name="phone" size={24} /></a>}
      </div>
    ) : (
      <nav class="bottom-bar" aria-label="Navigation mobile">
        {tabs.map(item => <a href={item.path} aria-current={current(item.path)}><Icon name={item.icon} />{item.label}</a>)}
      </nav>
    )}
  </body>
</html>
