---
import Base from '../../layouts/Base.astro';
import { getContent, type Entry } from '../../lib/wordpress';
import { featured, formatDate, plain, publicLinks } from '../../lib/html';
export async function getStaticPaths() {
  const { posts } = await getContent();
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Entry };
const image = featured(post);
---
<Base title={post.title.rendered} description={plain(post.excerpt.rendered)}>
  <article class="wrap prose page">
    <a class="back" href="/actualites/">← Actualités</a>
    <h1 set:html={post.title.rendered} />
    <time datetime={post.date}>{formatDate(post.date)}</time>
    {image?.source_url && <img class="page__image" src={image.source_url} alt={image.alt_text ?? ''} />}
    <Fragment set:html={publicLinks(post.content.rendered)} />
  </article>
</Base>
